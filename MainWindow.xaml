<Window x:Class="DeskBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:DeskBoard.Rendering"
        Title="DeskBoard"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        WindowState="Maximized"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        Stylus.IsTapFeedbackEnabled="False">

    <Window.Resources>
        <!-- Faint dot grid for the minimap paper -->
        <DrawingBrush x:Key="DotGrid" TileMode="Tile"
                      Viewport="0,0,9,9" ViewportUnits="Absolute"
                      Viewbox="0,0,9,9" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#2E8D877A">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1.5,1.5" RadiusX="0.9" RadiusY="0.9" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid x:Name="Root">

        <!-- ============ Board (surface + content), wrapped for PNG export ============ -->
        <Grid x:Name="BoardVisual">

            <!-- Warm paper surface (Board mode only) -->
            <Grid x:Name="BoardChrome" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">

                <!-- Soft-lit paper: warm center, gently darker edges -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.38"
                                             RadiusX="0.9" RadiusY="0.95">
                            <GradientStop Color="#FFF6F3EC" Offset="0.0" />
                            <GradientStop Color="#FFF1EDE4" Offset="0.6" />
                            <GradientStop Color="#FFE7E2D7" Offset="1.0" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Paper tooth -->
                <Rectangle Fill="{x:Static r:TextureFactory.BoardNoise}" />

                <!-- Corner vignette so the sheet doesn't read flat -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45"
                                             RadiusX="0.8" RadiusY="0.9">
                            <GradientStop Color="#00564C3A" Offset="0.75" />
                            <GradientStop Color="#12564C3A" Offset="1.0" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- Content viewport (zoom/pan) -->
            <Grid x:Name="Viewport" ClipToBounds="True">
                <Grid x:Name="BoardContent" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomScale" />
                            <TranslateTransform x:Name="PanTranslate" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Canvas x:Name="ItemsCanvas" Background="Transparent" />
                    <InkCanvas x:Name="Ink" Background="Transparent" />
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Empty-board hint -->
        <TextBlock x:Name="EmptyHint"
                   Text="pick a pen — or paste and drop anything onto the board"
                   FontFamily="Ink Free, Segoe Print, Comic Sans MS"
                   FontSize="30"
                   Foreground="#A9A290"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,0,0,120"
                   Opacity="0"
                   IsHitTestVisible="False" />

        <!-- Drop-target ring -->
        <Border x:Name="DropRing"
                Margin="24"
                BorderBrush="{StaticResource AccentRingFaint}"
                BorderThickness="2"
                CornerRadius="16"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

        <!-- ============ Floating chrome (Board mode only) ============ -->
        <!-- No background: everything between the pills stays click-through to the board. -->
        <Grid x:Name="ChromeLayer" Visibility="Collapsed" Opacity="0">

            <!-- Board title pill (top-left) -->
            <Button x:Name="TitlePill"
                    Style="{StaticResource ChromeButtonBase}"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="24,24,0,0"
                    ToolTip="Board menu">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Style="{StaticResource ChromeCard}" CornerRadius="24" />
                            <Border x:Name="hover" CornerRadius="24"
                                    Background="{StaticResource HoverTint}" Opacity="0" />
                            <ContentPresenter Margin="14,0,16,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" Height="48" VerticalAlignment="Center">
                    <Ellipse Width="22" Height="22" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.3" Center="0.45,0.4">
                                <GradientStop Color="#E3D4B4" Offset="0" />
                                <GradientStop Color="#C9B48F" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="DeskBoard"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource InkStrong}"
                               VerticalAlignment="Center" Margin="10,0,10,0" />
                    <TextBlock Text="&#xE70D;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="10"
                               Foreground="{StaticResource InkDim}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Hide + share (top-right) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,26,26,0">
                <Button x:Name="BtnHideBoard"
                        Style="{StaticResource ChromeFloatButton}"
                        Content="&#xE70D;"
                        ToolTip="Hide the board (Ctrl+Alt+D)" />
                <Button x:Name="BtnShare"
                        Style="{StaticResource ChromeDarkButton}"
                        Content="&#xE72D;"
                        Margin="12,0,0,0"
                        ToolTip="Copy a board snapshot to the clipboard" />
            </StackPanel>

            <!-- Tool rail (right, centered) -->
            <Border Style="{StaticResource ChromeCard}" CornerRadius="28"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,24,0" Padding="6,10">
                <StackPanel>
                    <Button x:Name="RailSelect" Style="{StaticResource ChromeRailButton}"
                            ToolTip="Select &amp; move (V)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE7C9;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="Select" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RailDraw" Style="{StaticResource ChromeRailButton}"
                            Margin="0,6,0,0" ToolTip="Draw (B)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE70F;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="Draw" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RailShape" Style="{StaticResource ChromeRailButton}"
                            Margin="0,6,0,0" ToolTip="Doodle shapes — drag on the board">
                        <StackPanel>
                            <Grid Width="20" Height="18" HorizontalAlignment="Center">
                                <Ellipse Width="11" Height="11"
                                         Stroke="{StaticResource InkStrong}" StrokeThickness="1.5"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Path Data="M10,17 L19.4,17 L14.7,8.6 Z"
                                      Stroke="{StaticResource InkStrong}" StrokeThickness="1.5"
                                      StrokeLineJoin="Round" />
                            </Grid>
                            <TextBlock Style="{StaticResource RailLabel}" Text="Shape" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RailNote" Style="{StaticResource ChromeRailButton}"
                            Margin="0,6,0,0" ToolTip="Add a sticky note (N)">
                        <StackPanel>
                            <Grid Width="18" Height="18" HorizontalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="-4" />
                                </Grid.RenderTransform>
                                <Border Background="#F0CD62" CornerRadius="2" Margin="0,1" />
                                <Path Data="M12,17 L17.6,17 L17.6,11.4 Z" Fill="#D8B44A"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                            <TextBlock Style="{StaticResource RailLabel}" Text="Note" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RailCalendar" Style="{StaticResource ChromeRailButton}"
                            Margin="0,6,0,0" ToolTip="Add a reminder (R)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE787;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="Calendar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RailImage" Style="{StaticResource ChromeRailButton}"
                            Margin="0,6,0,0" ToolTip="Pin an image… (or paste / drop one)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE8B9;" />
                            <TextBlock Style="{StaticResource RailLabel}" Text="Image" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RailMore" Style="{StaticResource ChromeRailButton}"
                            Margin="0,10,0,0" ToolTip="More tools">
                        <StackPanel>
                            <Border Width="30" Height="30" CornerRadius="15"
                                    Background="{StaticResource ActiveTint}">
                                <TextBlock Style="{StaticResource RailIcon}" Text="&#xE712;"
                                           FontSize="14" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource RailLabel}" Text="More" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Pen / color / shape bar (bottom, centered) -->
            <Border Style="{StaticResource ChromeCard}" CornerRadius="32"
                    Height="64"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,26" Padding="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button x:Name="BarUndo" Style="{StaticResource ChromeToolButton}"
                            Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" />

                    <!-- Pens (tips up; active pen rises on a white well) -->
                    <Button x:Name="PenFine" Style="{StaticResource ChromePenButton}"
                            Margin="14,0,0,0" ToolTip="Fine liner">
                        <Canvas Width="24" Height="48">
                            <Path Fill="#1F1D19" Data="M11.2,2 L12.8,2 L13.8,10 L10.2,10 Z" />
                            <Rectangle Canvas.Left="9.6" Canvas.Top="10" Width="4.8" Height="3.4"
                                       Fill="#A9A399" RadiusX="1" RadiusY="1" />
                            <Rectangle Canvas.Left="8" Canvas.Top="13.4" Width="8" Height="30.6"
                                       Fill="#33302A" RadiusX="2.5" RadiusY="2.5" />
                        </Canvas>
                    </Button>
                    <Button x:Name="PenChisel" Style="{StaticResource ChromePenButton}"
                            ToolTip="Chisel marker">
                        <Canvas Width="24" Height="48">
                            <Path Fill="#C05C3B" Data="M9,3.5 L15,3.5 L17,12 L7,12 Z" />
                            <Rectangle Canvas.Left="6" Canvas.Top="12" Width="12" Height="31"
                                       Fill="#D9704C" RadiusX="3" RadiusY="3" />
                            <Rectangle Canvas.Left="6" Canvas.Top="16" Width="12" Height="2.6"
                                       Fill="#C05C3B" Opacity="0.55" />
                        </Canvas>
                    </Button>
                    <Button x:Name="PenHighlighter" Style="{StaticResource ChromePenButton}"
                            ToolTip="Highlighter">
                        <Canvas Width="24" Height="48">
                            <Path Fill="#67794D" Data="M8.5,6 L15.5,6 L18,13.5 L6,13.5 Z" />
                            <Rectangle Canvas.Left="5" Canvas.Top="13.5" Width="14" Height="28"
                                       Fill="#7E9464" RadiusX="3" RadiusY="3" />
                            <Rectangle Canvas.Left="5" Canvas.Top="17.4" Width="14" Height="2.4"
                                       Fill="#6C8054" />
                        </Canvas>
                    </Button>
                    <Button x:Name="PenBrush" Style="{StaticResource ChromePenButton}"
                            ToolTip="Brush pen">
                        <Canvas Width="24" Height="48">
                            <Path Fill="#1F1D19"
                                  Data="M12,2 C10.4,5.5 9.4,8.5 9.4,11.5 L14.6,11.5 C14.6,8.5 13.6,5.5 12,2 Z" />
                            <Rectangle Canvas.Left="9" Canvas.Top="11.5" Width="6" Height="3.6"
                                       Fill="#A9A399" RadiusX="1" RadiusY="1" />
                            <Path Fill="#35322B" Data="M8.6,15.1 L15.4,15.1 L14.2,43.5 L9.8,43.5 Z" />
                        </Canvas>
                    </Button>

                    <!-- Colors -->
                    <Button x:Name="Swatch0" Style="{StaticResource ChromeSwatch}" Background="#262626"
                            Margin="16,0,0,0" ToolTip="Black" />
                    <Button x:Name="Swatch1" Style="{StaticResource ChromeSwatch}" Background="#D9704C"
                            Margin="6,0,0,0" ToolTip="Clay" />
                    <Button x:Name="Swatch2" Style="{StaticResource ChromeSwatch}" Background="#7E9464"
                            Margin="6,0,0,0" ToolTip="Moss" />
                    <Button x:Name="Swatch3" Style="{StaticResource ChromeSwatch}" Background="#7FA3C6"
                            Margin="6,0,0,0" ToolTip="Slate blue" />
                    <Button x:Name="Swatch4" Style="{StaticResource ChromeSwatch}" Background="#D9C7A6"
                            Margin="6,0,0,0" ToolTip="Sand" />
                    <Button x:Name="BtnCustomColor" Style="{StaticResource ChromeIconButton}"
                            Width="30" Height="30" FontSize="11"
                            Content="&#xE710;" Margin="6,0,0,0"
                            Foreground="{StaticResource InkDim}"
                            ToolTip="Custom color…" />

                    <Rectangle Style="{StaticResource ChromeDivider}" />

                    <!-- Doodle shapes + marker text -->
                    <Button x:Name="BtnShapeRect" Style="{StaticResource ChromeToolButton}"
                            Content="&#xE739;" ToolTip="Doodle box — drag on the board" />
                    <Button x:Name="BtnShapeEllipse" Style="{StaticResource ChromeToolButton}"
                            Margin="4,0,0,0"
                            ToolTip="Doodle circle — drag on the board (O)">
                        <Ellipse Width="14" Height="14"
                                 Stroke="{StaticResource InkStrong}" StrokeThickness="1.5" />
                    </Button>
                    <Button x:Name="BtnShapeArrow" Style="{StaticResource ChromeToolButton}"
                            Margin="4,0,0,0" ToolTip="Doodle arrow — drag on the board (A)">
                        <TextBlock Text="&#xE72A;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="BtnTextTool" Style="{StaticResource ChromeToolButton}"
                            Margin="4,0,0,0" ToolTip="Marker text — click the board to place (T)">
                        <TextBlock Text="T"
                                   FontFamily="Georgia, Segoe UI"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkStrong}" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Zoom cluster (bottom-left) -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="24,0,0,26">
                <Border Style="{StaticResource ChromeCard}" CornerRadius="22" Height="44"
                        Padding="6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnZoomOut" Style="{StaticResource ChromeIconButton}"
                                Content="&#xE738;" FontSize="12" ToolTip="Zoom out (Ctrl+-)" />
                        <TextBlock x:Name="ZoomLabel" Text="100%"
                                   Width="42" TextAlignment="Center"
                                   FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12.5"
                                   Foreground="{StaticResource InkStrong}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnZoomIn" Style="{StaticResource ChromeIconButton}"
                                Content="&#xE710;" FontSize="12" ToolTip="Zoom in (Ctrl++)" />
                    </StackPanel>
                </Border>
                <Button x:Name="BtnFit" Style="{StaticResource ChromeSquareButton}"
                        Margin="12,0,0,0" Content="&#xE740;"
                        ToolTip="Fit to screen (Ctrl+0)" />
                <Button x:Name="BtnBento" Style="{StaticResource ChromeSquareButton}"
                        Margin="12,0,0,0" Content="&#xF0E2;"
                        ToolTip="Snap items into a bento grid" />
            </StackPanel>

            <!-- Minimap (bottom-right): drag the white window to pan -->
            <Border x:Name="MinimapCard" Style="{StaticResource ChromeCard}" CornerRadius="14"
                    Width="190" Height="112"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,26" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F1EDE2" CornerRadius="8"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Rectangle Fill="{StaticResource DotGrid}" Margin="4" RadiusX="6" RadiusY="6" />
                            <Canvas x:Name="MinimapArea" ClipToBounds="True" Background="Transparent"
                                    Cursor="Hand">
                                <Border x:Name="MinimapViewRect"
                                        Background="#FFFFFF" CornerRadius="3"
                                        BorderBrush="#D2CCBD" BorderThickness="1"
                                        Effect="{StaticResource ShadowSmall}" />
                            </Canvas>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="&#xE7C9;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15" Foreground="{StaticResource InkDim}"
                               VerticalAlignment="Center" Margin="10,0,2,0"
                               ToolTip="Space + drag (or middle-drag) to pan when zoomed" />
                </Grid>
            </Border>
        </Grid>

        <!-- Today strip: due/overdue reminders stay glanceable in Hidden mode -->
        <StackPanel x:Name="TodayStrip"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
    </Grid>
</Window>
